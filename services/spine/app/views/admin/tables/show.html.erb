<% content_for :title, "Spine — #{@table.name}" %>

<header>
  <h1><%= link_to "Spine", admin_tables_path %> / <%= @table.name %></h1>
  <p class="subtitle mono">tableId <%= @table.id %> · <%= @table.status %> · following along (refreshes every 5s)</p>
</header>

<main>
  <h2>Seats</h2>
  <% if @seats.empty? %>
    <p class="empty">Nobody seated. Spectators need nothing.</p>
  <% else %>
    <table class="log seats">
      <thead><tr><th>seat</th><th>player</th><th>seatId</th></tr></thead>
      <tbody>
        <% @seats.each do |seat| %>
          <tr>
            <td><%= seat.number %></td>
            <td><%= seat.player_name %></td>
            <td class="mono"><%= seat.id %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <h2>The log <span class="count">(<%= @events.size %> events)</span></h2>
  <table class="log events">
    <thead>
      <tr>
        <th>seq</th>
        <th>accepted at</th>
        <th>name</th>
        <th>initiator</th>
        <th>via</th>
        <th>payload</th>
        <th>trace</th>
      </tr>
    </thead>
    <tbody>
      <% @events.each do |event| %>
        <tr>
          <td class="seq"><%= event.seq %></td>
          <td class="mono"><%= event.accepted_at.utc.strftime("%H:%M:%S.%L") %></td>
          <td class="event-name"><%= event.name %></td>
          <td><%= event.initiator %></td>
          <td><%= event.occurred_in %></td>
          <td><pre class="payload"><%= JSON.pretty_generate(event.payload) %></pre></td>
          <td><%= link_to "trace", honeycomb_trace_url(event), target: "_blank", rel: "noopener", class: "trace-link" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</main>

<script>
  // v0 real-time-ish: reload the page every 5 seconds.
  setTimeout(function () { window.location.reload(); }, 5000);
</script>
