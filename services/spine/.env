# Spine local config. Source the repo root's .be BEFORE this file:
# OTEL_EXPORTER_OTLP_HEADERS interpolates $HONEYCOMB_API_KEY at source time.
# The `run` script does this in the right order.
export PORT=4600

# OpenTelemetry configuration for Honeycomb
export OTEL_SERVICE_NAME="spine"
export OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
export OTEL_EXPORTER_OTLP_ENDPOINT="https://api.honeycomb.io:443"
export OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=$HONEYCOMB_API_KEY"
export OTEL_METRICS_EXPORTER=none
export OTEL_LOGS_EXPORTER=none

# Where the admin screen's Honeycomb trace links point (local telemetry lands in
# the `local` environment; prod overrides this to `mtg-deck-shuffler`).
export HONEYCOMB_ENV_SLUG="local"
export HONEYCOMB_TEAM_SLUG="modernity"
