#!/bin/bash

port_override=$PORT

source .env

# port_override if defined, otherwise $PORT as defined in .env
APP_PORT=${port_override:-${PORT}}

# Locally, the Tabletop must hotlink playmat/card-back images from THIS server,
# not the prod default baked into port-tabletop/types.ts::shufflerPublicUrl().
# Only set it if the caller hasn't already (e.g. testing against prod).
export SHUFFLER_PUBLIC_URL=${SHUFFLER_PUBLIC_URL:-"http://localhost:$APP_PORT"}

# Announce readiness once the app answers, so you (or a script) don't have to poll
# by hand. Runs alongside npm start, which stays in the foreground as usual.
(
  for _ in $(seq 1 60); do
    if curl -s "http://localhost:$APP_PORT/health" >/dev/null 2>&1; then
      echo "──────────────────────────────────────────────"
      echo "✅ app ready          http://localhost:$APP_PORT/"
      echo "──────────────────────────────────────────────"
      break
    fi
    sleep 0.5
  done
) &

PORT=$APP_PORT npm start
