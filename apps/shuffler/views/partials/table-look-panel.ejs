<%
// Expects: playmats, selectedPlaymatPath, sleeveQuickPicks, sleeveColor, prepId.
// Every swatch hx-posts to /prep-table-look/:prepId, swapping in the
// re-rendered #playmat-prepare fragment (partials/playmat-prepare.ejs).
// table-look-focus.js restores keyboard focus after that swap.
const customSleeveSelected = sleeveColor && !sleeveQuickPicks.some(function (p) { return p.hex === sleeveColor; });
%>
<section class="table-look-panel" data-testid="table-look-panel" data-prep-id="<%= prepId %>" aria-label="Playmat and sleeves">
  <div class="table-look-row">
    <span class="table-look-label">Playmat</span>
    <div class="table-look-mats">
      <% playmats.forEach(function(mat, index) { %>
        <button type="button"
                id="table-look-mat-<%= index %>"
                class="table-look-mat<%= mat.path === selectedPlaymatPath ? ' table-look-selected' : '' %>"
                data-mat-path="<%= mat.path %>"
                title="<%= mat.name %>"
                aria-label="Playmat: <%= mat.name %>"
                style="background-image: url('<%= mat.path %>')"
                hx-post="/prep-table-look/<%= prepId %>"
                hx-vals='{"playmat-path": "<%= mat.path %>"}'
                hx-target="#playmat-prepare"
                hx-swap="outerHTML"></button>
      <% }) %>
    </div>
  </div>
  <div class="table-look-row">
    <span class="table-look-label">Sleeves</span>
    <div class="table-look-sleeves">
      <button type="button"
              id="table-look-sleeve-none"
              class="table-look-sleeve table-look-none-chip<%= sleeveColor ? '' : ' table-look-selected' %>"
              data-sleeve-color=""
              title="No sleeves (standard Magic back)"
              aria-label="No sleeves"
              hx-post="/prep-table-look/<%= prepId %>"
              hx-vals='{"sleeve-color": ""}'
              hx-target="#playmat-prepare"
              hx-swap="outerHTML"></button>
      <% sleeveQuickPicks.forEach(function(pick, index) { %>
        <button type="button"
                id="table-look-sleeve-<%= index %>"
                class="table-look-sleeve<%= sleeveColor === pick.hex ? ' table-look-selected' : '' %>"
                data-sleeve-color="<%= pick.hex %>"
                title="<%= pick.name %>"
                aria-label="Sleeves: <%= pick.name %>"
                style="background-color: <%= pick.hex %>"
                hx-post="/prep-table-look/<%= prepId %>"
                hx-vals='{"sleeve-color": "<%= pick.hex %>"}'
                hx-target="#playmat-prepare"
                hx-swap="outerHTML"></button>
      <% }) %>
      <label class="table-look-custom<%= customSleeveSelected ? ' table-look-selected' : '' %>">
        custom
        <input type="color" class="table-look-color-input" name="sleeve-color"
               value="<%= customSleeveSelected ? sleeveColor : '#bb5277' %>"
               hx-post="/prep-table-look/<%= prepId %>"
               hx-trigger="change"
               hx-target="#playmat-prepare"
               hx-swap="outerHTML" />
      </label>
    </div>
  </div>
</section>
