<%#
  Thin adapter over the one page shell (formatHtmlHead in
  src/view/common/html-layout.ts, exposed via app.locals). The EJS pages'
  only head-shape difference from /game lives here: they all load site.css.
%>
<%- formatHtmlHead({
  title: pageTitle,
  stylesheets: ['/site.css'].concat(locals.additionalStyles || []),
  additionalFonts: locals.additionalFonts,
  scriptsHtml: locals.script ? '<script src="' + script + '" defer></script>' : ''
}) %>
