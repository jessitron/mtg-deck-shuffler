            <div class="swatch-chip" style="background: #e91e63;"></div>
            <div class="swatch-meta"><span class="swatch-name">Material pink</span><span class="swatch-hex">#e91e63</span><span class="swatch-use">play button</span></div>
          </div>
          <div class="swatch">
            <div class="swatch-chip" style="background: #9c27b0;"></div>
