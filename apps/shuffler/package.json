{
  "name": "mtg-deck-shuffler",
  "version": "1.0.0",
  "description": "Simple MTG deck app for remote play",
  "author": "Jessica Kerr <jessitron@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jessitron/mtg-deck-shuffler.git"
  },
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "npx tsc",
    "clean": "rm -rf dist",
    "start": "npm run build && node --import ./dist/tracing.js dist/server.js",
    "test": "jest",
    "test:verify": "./verify.sh",
    "deck:download": "node dist/scripts/download-deck.js",
    "decks:backfill-images": "npm run build && node dist/scripts/backfill-deck-images.js",
    "decks:backfill-set-names": "npm run build && node dist/scripts/backfill-set-names.js",
    "card:inspect": "node dist/scripts/inspect-archidekt-card.js",
    "precons:fetch-mtgjson": "node dist/scripts/fetch-mtgjson-precons.js"
  },
  "dependencies": {
    "@fleet/design-tokens": "1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-express": "^0.69.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "better-sqlite3": "^12.6.2",
    "ejs": "^3.1.10",
    "express": "^4.22.1",
    "tar": "^7.5.9",
    "undici": "^7.29.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@playwright/test": "^1.57.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.2.1",
    "@types/tar": "^6.1.13",
    "fast-check": "^4.3.0",
    "jest": "^30.1.3",
    "stream-json": "^3.4.0",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
