export PORT=5180

# OpenTelemetry configuration for Honeycomb (server-side spans).
# CAUTION: $HONEYCOMB_API_KEY is interpolated AT SOURCE TIME — source the repo
# root's .be (which defines it) BEFORE this file, or export silently 401s.
export OTEL_SERVICE_NAME="mtg-tabletop"
export OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
export OTEL_EXPORTER_OTLP_ENDPOINT="https://api.honeycomb.io:443"
export OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=$HONEYCOMB_API_KEY"
export OTEL_METRICS_EXPORTER=none
export OTEL_LOG_LEVEL="info"

# Browser spans (service mtg-tabletop-web): preferred destination is an OTel
# Collector (set BROWSER_OTLP_TRACES_URL to its OTLP-http /v1/traces endpoint,
# CORS required — see otel-collector-local.yaml). When that's unset, this
# local-only fallback lets the page export straight to Honeycomb with the
# server's key. Local dev convenience ONLY — never set this in k8s.
export ALLOW_BROWSER_DIRECT_HONEYCOMB=true

# ECR repository for deploy.sh
export ECR_REPO=414852377253.dkr.ecr.us-west-2.amazonaws.com/mtg-tabletop
