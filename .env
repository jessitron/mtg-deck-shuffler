export PORT=3333

# OpenTelemetry configuration for Honeycomb
export OTEL_SERVICE_NAME="mtg-deck-shuffler"
export OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
export OTEL_EXPORTER_OTLP_ENDPOINT="https://api.honeycomb.io:443"
export OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=$HONEYCOMB_API_KEY"
export OTEL_METRICS_EXPORTER=none
export OTEL_LOG_LEVEL="info"

# ECR repository for deploy.sh
export ECR_REPO=414852377253.dkr.ecr.us-west-2.amazonaws.com/mtg-deck-shuffler

# Trainer Agent (dev-mode "Improve the Advisor" chat). Wiring per INTERFACE.md.
# Leave TRAINER_AGENT_URL unset to keep the placeholder reply (no agent calls).
# Uncomment to go live against the real front door (a chat turn can open a PR!):
#   export TRAINER_AGENT_URL=https://3zpl56dwi54putsdjtecwnyqim0sdjmh.lambda-url.us-west-2.on.aws/
# For local/CI testing point it at the front-door stub instead:
#   export TRAINER_AGENT_URL=http://localhost:8080/
# TRAINER_AGENT_TOKEN is a SECRET — set it in .be (untracked), NOT here. Fetch it
# from the trainer-agent sandbox Secrets Manager (see that repo's notes/infrastructure.md).
