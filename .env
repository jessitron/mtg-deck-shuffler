export PORT=3333

# OpenTelemetry configuration for Honeycomb
export OTEL_SERVICE_NAME="mtg-deck-shuffler"
export OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
export OTEL_EXPORTER_OTLP_ENDPOINT="https://api.honeycomb.io:443"
export OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=$HONEYCOMB_API_KEY"
export OTEL_METRICS_EXPORTER=none
export OTEL_LOG_LEVEL="info"

# ECR repository for deploy.sh
export ECR_REPO=414852377253.dkr.ecr.us-west-2.amazonaws.com/mtg-deck-shuffler

# Trainer Agent (dev-mode "Improve the Advisor" chat). Wiring per INTERFACE.md.
# LOCAL: `./run` stands up the fake front door (test/verification/fake-frontdoor.mjs)
# on :8099 and sets TRAINER_AGENT_URL to it, so the chat talks to a contract-faithful
# stub (v1.0) instead of the bare placeholder. Override the port with
# TRAINER_FRONTDOOR_PORT. If TRAINER_AGENT_URL is unset entirely, the chat falls back
# to a placeholder reply (no agent calls).
# PROD uses the REAL front door, wired in Kubernetes (k8s/configmap.yaml for the URL
# + the mtg-deck-shuffler-secret for TRAINER_AGENT_TOKEN), NOT here. Don't set the
# real URL/token in this tracked file.
